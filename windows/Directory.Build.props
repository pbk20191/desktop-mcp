<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <Authors>desktop-mcp contributors</Authors>
    <!-- Win2D ships a per-architecture native DLL and warns (WIN2D0001) on AnyCPU builds; default to the RID of the dotnet/MSBuild process (not the OS, which may be emulating it). -->
    <DefaultProcessRid>win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</DefaultProcessRid>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(DefaultProcessRid)</RuntimeIdentifier>
    <!-- Windows App SDK: unpackaged, framework-dependent; AppRuntime.EnsureInitialized bootstraps it explicitly. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>

  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)tests\default.runsettings</RunSettingsFilePath>
  </PropertyGroup>
</Project>
