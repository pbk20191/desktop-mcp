<Project>
  <!--
    NativeAOT exes (src/DesktopMcp, probes/DesktopMcp.Probe; their csprojs set PublishAot): link Win2D statically
    when published. The file is imported for every PublishAot project with a RuntimeIdentifier, for build and run
    too; only its hooked targets are publish-only.
  -->
  <Import Project="$(MSBuildThisFileDirectory)build\Win2DStatic.targets"
          Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''" />

  <!--
    NativeAOT exes ship one file (plus its pdb). Referenced projects are compiled into the exe, so their
    .pdb/.pri must not be copied next to it: keep only .xml as a related file (the property cannot be empty,
    which would restore the default) and do not publish referenced documentation files either.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
</Project>
