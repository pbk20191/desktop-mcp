<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinFormsTarget (the ToolStrip click test); a framework reference, not a package. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="..\..\src\DesktopMcp.Desktop\DesktopMcp.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Only WinFormsTarget uses WinForms; keep its names (Point, Screen, Timer...) out of the other files. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
