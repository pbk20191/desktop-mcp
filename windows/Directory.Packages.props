<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows App SDK 2.5.1 components (the metapackage's set): only what we use, no bootstrap DLL. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <!-- Win2D's dependencies, pinned to the 2.5.1 set and excluded from every build (Directory.Build.props). -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <!-- Kestrel endpoints for the MCP SDK (spec §2); its only dependency is ModelContextProtocol [2.2.0]. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- Published 2026-07-02. Source-generated, NativeAOT ready; reads TOML 1.1. -->
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
    <!-- Published 2026-09-08 (2.0.13 is newer than two weeks). AOT probe on 2026-10-19: zero warnings. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <!-- Published 2026-10-05 (0.3.355 and later are newer than two weeks). Source generator only: Win32/WDK bindings from metadata. -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.347" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
