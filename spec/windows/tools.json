                "type": "boolean"
              },
              {
                "type": "string"
              }
            ],
            "default": true
          },
          "use_ui_tree": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ],
            "default": true
          },
          "width_reference_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "height_reference_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "display": {
