            "focus",
            "move",
            "resize",
            "minimize",
            "restore",
            "close",
            "maximize",
            "fullscreen",
            "exit_fullscreen",
            "display",
            "displays"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "app": {
          "type": [
            "string",
            "null"
          ]
        },
        "display": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "loc": {
