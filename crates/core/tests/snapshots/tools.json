        "mode": {
          "$ref": "#/$defs/Mode",
          "default": "list"
        },
        "size": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "Window"
  }
