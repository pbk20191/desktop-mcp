      "title": "App"
    },
    "description": "Manages macOS applications with six modes: 'launch' (opens the application), 'resize' (adjusts active window size), 'move' (repositions active window), 'switch' (brings specific app into focus), 'quit' (asks every process with that name or bundle id to quit; the app may ask to save), 'force_quit' (terminates them without asking). Quit never targets desktop-mcp itself or loginwindow.",
    "inputSchema": {
      "$defs": {
        "Mode": {
          "enum": [
            "launch",
            "resize",
            "move",
            "switch",
            "quit",
            "force_quit"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "mode": {
          "$ref": "#/$defs/Mode",
          "default": "launch"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "window_loc": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "window_size": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "App"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Batch"
    },
    "description": "Runs several tool calls in order as one call, e.g. a Click, then a Type, then a Shortcut. 'steps' (1-20) is a list of {\"tool\": \"<name>\", \"arguments\": {...}}; each step runs exactly as a call of that tool on its own would, with the same checks. 'delay' seconds (default 0.5, 0-10) pass between steps, so the UI can settle and two clicks at one point are not taken as a double-click. With 'stop_on_error' (default true) the first failing step ends the batch. Steps run without looking at the screen: after launching or switching to an app, wait for an element you will type into (Wait until='element'), not just for its window, which can appear before the app takes input. Every step's tool is checked before any step runs: a tool that does not exist or is not enabled, or Batch itself, refuses the whole batch. Returns one line per step that ran, '[n] <Tool>: <its result>', and only the last image a step produced (e.g. Snapshot with use_vision), saying which step it came from.",
    "inputSchema": {
      "$defs": {
        "BatchStep": {
          "properties": {
            "arguments": {
              "additionalProperties": true,
              "default": {},
              "description": "That tool's arguments, as it takes them on its own",
              "type": "object"
            },
            "tool": {
              "description": "The tool to run, e.g. \"Click\"",
              "type": "string"
            }
          },
          "required": [
            "tool"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "delay": {
          "default": 0.5,
          "format": "double",
          "maximum": 10,
          "minimum": 0,
          "type": "number"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/BatchStep"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "stop_on_error": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "steps"
      ],
      "type": "object"
    },
    "name": "Batch"
  },
