{
  "tools": [
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "App"
      },
      "description": "Manages Windows applications with six modes: 'launch' (opens an app by its Start menu name, or an executable by its full path), 'resize' (adjusts the focused window's size), 'move' (repositions the focused window), 'switch' (brings the named app's window to the front), 'quit' (asks every window of that app to close; the app may ask to save), 'force_quit' (ends its processes without asking). 'name' is the app's name or executable. Quit never targets desktop-mcp itself or the Windows shell.",
      "inputSchema": {
        "$defs": {
          "Mode": {
            "enum": [
              "launch",
              "resize",
              "move",
              "switch",
              "quit",
              "force_quit"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "mode": {
            "$ref": "#/$defs/Mode",
            "default": "launch"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "window_loc": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "window_size": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "name": "App"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Click"
      },
      "description": "Performs mouse clicks at specified coordinates [x, y]. Supports button types: 'left' for selection/activation, 'right' for context menus, 'middle'. Supports clicks: 0=hover only, 1=single click, 2=double click.",
      "inputSchema": {
        "$defs": {
          "Button": {
            "enum": [
              "left",
              "right",
              "middle"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "button": {
            "$ref": "#/$defs/Button",
            "default": "left"
          },
          "clicks": {
            "default": 1,
            "format": "int64",
            "type": "integer"
          },
          "loc": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "loc"
        ],
        "type": "object"
      },
      "name": "Click"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Clipboard"
      },
      "description": "Reads or writes the clipboard. mode='read' (default) returns the copied text, file paths and image; mode='write' replaces the clipboard with 'text' or with the files in 'paths' (which must exist), not both.",
      "inputSchema": {
        "$defs": {
          "ClipboardMode": {
            "enum": [
              "read",
              "write"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "mode": {
            "$ref": "#/$defs/ClipboardMode",
            "default": "read"
          },
          "paths": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "name": "Clipboard"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Move"
      },
      "description": "Moves mouse cursor to coordinates [x, y]. Set drag=True to perform a drag-and-drop operation from current position to target coordinates.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "drag": {
            "default": false,
            "type": "boolean"
          },
          "loc": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "loc"
        ],
        "type": "object"
      },
      "name": "Move"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "MultiEdit"
      },
      "description": "Types into several fields, locs=[[x, y, \"text\"], ...] in order: clicks each field, clears it, and types its text.",
      "inputSchema": {
        "properties": {
          "locs": {
            "items": {
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": [
          "locs"
        ],
        "type": "object"
      },
      "name": "MultiEdit"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "MultiSelect"
      },
      "description": "Clicks several locations [[x, y], ...] in order. press_ctrl=true (default) holds ctrl throughout, to select several files, folders or list items; false clicks each one plainly.",
      "inputSchema": {
        "properties": {
          "locs": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array"
          },
          "press_ctrl": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "locs"
        ],
        "type": "object"
      },
      "name": "MultiSelect"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Notification"
      },
      "description": "Sends a Windows toast notification with a message, title, optional subtitle, and optional sound.",
      "inputSchema": {
        "$defs": {
          "NotificationSound": {
            "enum": [
              "Default",
              "IM",
              "Mail",
              "Reminder",
              "SMS"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "message": {
            "type": "string"
          },
          "sound": {
            "anyOf": [
              {
                "$ref": "#/$defs/NotificationSound"
              },
              {
                "type": "null"
              }
            ]
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "default": "Notification",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "name": "Notification"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "OCR"
      },
      "description": "Reads the text shown on screen with Windows OCR and returns one line per text line, top to bottom: '[cx,cy] \"<text>\" (w×h, confidence 1.00)', where [cx,cy] is the line's centre in the screen coordinates Click takes. 'region' [x, y, width, height] in screen pixels (default the focused window, else the primary display); 'languages' (default [\"ko-KR\", \"en-US\"]; the first one with Windows OCR installed is used, else the user's languages). 'level' and 'min_confidence' are accepted but change nothing on Windows, which reports no confidence.",
      "inputSchema": {
        "$defs": {
          "OcrLevel": {
            "enum": [
              "accurate",
              "fast"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "languages": {
            "default": [
              "ko-KR",
              "en-US"
            ],
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "level": {
            "$ref": "#/$defs/OcrLevel",
            "default": "accurate"
          },
          "min_confidence": {
            "default": 0.3,
            "format": "double",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "region": {
            "default": null,
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "name": "OCR"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Scrape"
      },
      "description": "Fetch content from a URL. Performs a lightweight HTTP request and returns the page content as text.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "name": "Scrape"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Screenshot"
      },
      "description": "Captures a display, or a region of the screen, as an image, without reading the UI tree (faster than Snapshot with use_vision; use Snapshot for element ids). 'display' is a display index from Window mode='displays' (default: the display of the focused window, else the primary). 'region' [x, y, width, height] in screen pixels captures only that rectangle and takes precedence over 'display'. The image is at most 1568 pixels on its longer side; when it was scaled down, the text says by how much, so image coordinates can be turned into the screen coordinates Click takes.",
      "inputSchema": {
        "properties": {
          "display": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "region": {
            "items": {
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "name": "Screenshot"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Scroll"
      },
      "description": "Scrolls at coordinates [x, y] or current mouse position if loc=None. Type: vertical (default) or horizontal. Direction: up/down for vertical, left/right for horizontal. wheel_times controls scroll amount.",
      "inputSchema": {
        "$defs": {
          "ScrollDirection": {
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ],
            "type": "string"
          },
          "ScrollType": {
            "enum": [
              "horizontal",
              "vertical"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "direction": {
            "$ref": "#/$defs/ScrollDirection",
            "default": "down"
          },
          "loc": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "type": {
            "$ref": "#/$defs/ScrollType",
            "default": "vertical"
          },
          "wheel_times": {
            "default": 1,
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "Scroll"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Shell"
      },
      "description": "Execute commands on Windows in PowerShell (PowerShell 7 when installed, else Windows PowerShell 5.1). Use for file system, process management, system operations, and automation scripts. SECURITY WARNING: Commands are executed with the same permissions as the terminal/application running this server. Review and understand all actions before execution, especially those involving file operations, system modifications, or external processes.",
      "inputSchema": {
        "$defs": {
          "ShellMode": {
            "enum": [
              "shell",
              "osascript"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "command": {
            "type": "string"
          },
          "mode": {
            "default": "powershell",
            "enum": [
              "powershell"
            ],
            "type": "string"
          },
          "timeout": {
            "default": 10,
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "name": "Shell"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Shortcut"
      },
      "description": "Executes keyboard shortcuts using key combinations separated by +. Examples: \"ctrl+c\" (copy), \"ctrl+v\" (paste), \"alt+tab\" (switch windows), \"win+r\" (Run), \"ctrl+shift+esc\" (Task Manager). Modifiers: ctrl, shift, alt, win.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "shortcut": {
            "type": "string"
          }
        },
        "required": [
          "shortcut"
        ],
        "type": "object"
      },
      "name": "Shortcut"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Snapshot"
      },
      "description": "Captures complete desktop state including: focused window, open applications, interactive elements (buttons, text fields, links, menus with coordinates), and scrollable areas. Set use_vision=True to include screenshot with numbered annotations on interactive elements. Always call this first to understand the current desktop state before taking actions.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "use_vision": {
            "default": false,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "Snapshot"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Type"
      },
      "description": "Types text at specified coordinates [x, y]. Set clear=True to clear existing text first. Set press_enter=True to submit after typing. Set caret_position to 'start', 'end', or 'idle' (default).",
      "inputSchema": {
        "$defs": {
          "Caret": {
            "enum": [
              "start",
              "idle",
              "end"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "caret_position": {
            "$ref": "#/$defs/Caret",
            "default": "idle"
          },
          "clear": {
            "default": false,
            "type": "boolean"
          },
          "loc": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "press_enter": {
            "default": false,
            "type": "boolean"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "loc",
          "text"
        ],
        "type": "object"
      },
      "name": "Type"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Wait"
      },
      "description": "Waits a fixed 'duration' in seconds, or with 'until' waits for a condition, checking with backoff until it holds or 'timeout' seconds (default 10) pass, then fails. 'duration' is ignored with 'until'. Conditions: 'app_running' / 'app_quit' ('app': application name or executable); 'window' / 'window_gone' ('app' and/or 'title', a case-insensitive substring; 'window' returns the matching Window list lines); 'element' ('title' and/or 'role', a UI Automation control type such as Button, Edit or MenuItem, in 'app' or else the focused window's app; title matches the element's name; returns '<role> \"<title>\" at [x,y]', the centre in Click coordinates).",
      "inputSchema": {
        "$defs": {
          "WaitUntil": {
            "enum": [
              "app_running",
              "app_quit",
              "window",
              "window_gone",
              "element"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "app": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "timeout": {
            "default": 10,
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "until": {
            "anyOf": [
              {
                "$ref": "#/$defs/WaitUntil"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "name": "Wait"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Window"
      },
      "description": "Lists and arranges application windows. 'list' (default) returns one line per window: '<id>\\t<app>\\t\"<title>\"\\t[x,y,w,h]\\t<flags>' (flags: focused, minimized, fullscreen), optionally only for 'app' (application name or executable). The other modes act on the window 'id' from list: 'focus', 'move' (to 'loc' [x, y]), 'resize' (to 'size' [width, height]), 'minimize', 'restore', 'close' (asks the window to close; the app may ask to save), 'maximize' (fills its display minus the taskbar), 'fullscreen', 'exit_fullscreen', 'display' (moves it to display index 'display', same relative position, kept inside that display). 'displays' (no id) returns one line per display: '<index>\\t<name>\\t[x,y,w,h]\\tvisible [x,y,w,h]\\tscale <s>', then 'main' for the primary one, in the same physical screen pixels as window frames. 'maximize' and 'display' refuse a window in full screen or minimized. A window that closed since it was listed is refused; list again.",
      "inputSchema": {
        "$defs": {
          "Mode": {
            "enum": [
              "list",
              "focus",
              "move",
              "resize",
              "minimize",
              "restore",
              "close",
              "maximize",
              "fullscreen",
              "exit_fullscreen",
              "display",
              "displays"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "app": {
            "type": [
              "string",
              "null"
            ]
          },
          "display": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "loc": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "mode": {
            "$ref": "#/$defs/Mode",
            "default": "list"
          },
          "size": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "name": "Window"
    }
  ]
}
